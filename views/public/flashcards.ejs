<section class="u-clearfix u-palette-1-dark-1 u-section-1" id="sec-5430">
    <div class="u-clearfix u-sheet u-valign-middle u-sheet-1">
        <h1 class="u-text u-text-default u-text-1">Flashcard-u<span style="font-weight: 700;"></span>ri
        </h1>
        <h3 class="u-align-center u-text u-text-grey-10 u-text-2">Descopera larga noastra colectie de flashcard-uri
            facute pentru a va ajuta sa invatati despre UE. </h3>
    </div>
</section>
<section class="u-clearfix u-section-2" id="sec-8685">
    <div class="u-clearfix u-sheet u-valign-middle u-sheet-1">
        <div class="u-expanded-width u-list u-list-1">
            <div class="u-repeater u-repeater-1">
                <%
                let index = 0;
                flashcards.forEach(flashcard => {
                %>
                    <div class="u-container-style u-list-item u-repeater-item" style="cursor: pointer">
                        <div class="u-container-layout u-similar-container u-container-layout-1">
                            <div class="custom-expanded u-align-left u-container-style u-group u-hover-feature u-palette-1-base u-radius u-shape-round u-group-1">
                                <div class="u-container-layout u-valign-middle u-container-layout-2"
                                     onclick="const flash = document.getElementById('flash_<%= index %>');
                                             if(flash.innerHTML === '<%= flashcard.question %>') {
                                             flash.innerHTML = '<%= flashcard.answer %>'
                                             flash.parentElement.classList.add('u-palette-1-light-1');
                                             } else {
                                             flash.innerHTML = '<%= flashcard.question %>'
                                             flash.parentElement.classList.remove('u-palette-1-light-1');
                                             }
                                             ">
                                    <h4 class="u-align-center u-text u-text-1"
                                        id="flash_<%= index %>"><%= flashcard.question %></h4>
                                </div>
                            </div>
                        </div>
                    </div>
                <%
                    index++;
                });
                %>
            </div>
        </div>
    </div>
</section>

