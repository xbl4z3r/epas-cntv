        <h1 class="u-align-center u-text u-text-default u-title u-text-1">Blog Posts </h1>
        <p class="u-align-center u-large-text u-text u-text-variant u-text-2">Cele mai noi articole scrise de
            Ambasadorii Juniori.</p>
    </div>
</section>
<section class="u-clearfix u-section-2" id="sec-f8f4">
    <div class="u-clearfix u-sheet u-valign-middle u-sheet-1">
        <div class="u-blog u-expanded-width u-blog-1">
            <div class="u-list-control"></div>
            <div class="u-repeater u-repeater-1">
                <%
                let count = 1;
                posts.forEach(post => {
                    const href = `/blog/${post._id}`;
                    const thumbnail = `data:${post.thumbnail.contentType};base64,${post.thumbnail.data}`;
                %>
                <div class="u-blog-post u-container-style u-repeater-item u-white u-repeater-item-1">
                    <div class="u-container-layout u-similar-container u-valign-top u-container-layout-1">
                        <h4 class="u-blog-control u-text u-text-1">
                            <a class="u-post-header-link" href="<%= href %>"><%= post.title %></a>
                        </h4>
                        <a class="u-post-header-link" href="<%= href %>"><img alt=""
                                                                              class="u-blog-control u-expanded-width u-image u-image-default u-image-1"
                                                                              src="<%= thumbnail %>"></a>
                        <div class="u-blog-control u-post-content u-text u-text-4 fr-view">
                            <%= post.content > 100 ? post.content.substring(0, 100) + '...' : post.content %>
                        </div>
                        <a href="<%= href %>"
                           class="u-blog-control u-border-2 u-border-no-left u-border-no-right u-border-no-top u-border-palette-1-base u-btn u-btn-rectangle u-button-style u-none u-btn-1">
                            Deschide
                            postarea
                        </a>
                    </div>
                </div>
                <%
                    count++;
                });
                %>
            </div>
            <div class="u-list-control"></div>
        </div>
    </div>
</section>


