            <img class="u-image u-image-contain u-image-default u-image-1"
                 src="/images/g68e39791adde6694dc03bc7b5e7c94e337f77f0dfd144515fab10600c7f014a9639322e55f8f73e1617262ad280b8f2e_1280.png"
                 alt="" data-image-width="1280" data-image-height="1271">
            <%
            const percentage = (session.score / session.questions.length) * 100;
            const percentageText = percentage > 90 ? 'Felicitări!' : percentage > 75 ? 'Foarte bine!' : percentage > 60 ? 'Bine!' : percentage > 40 ? 'Binișor!' : 'Mai ai de lucrat!';
            const description = percentage > 90 ? 'Ești un adevărat expert în UE!' : percentage > 75 ? 'Ești foarte aproape de a deveni un expert în UE!' : percentage > 60 ? 'Ești pe drumul cel bun!' : percentage > 40 ? 'Mai ai de lucrat, dar ești pe drumul cel bun!' : 'Mai ai de lucrat, dar nu te descuraja!';
            %>
            <h1 class="u-align-center u-text u-text-default u-title u-text-1"><%= percentageText %></h1>
            <h3 class="u-align-center u-text u-text-default u-text-2">Ai raspuns corect la <%= session.score %>
                din <%= session.questions.length %> intrebari. </h3>
            <h3 class="u-align-center u-text u-text-3"><%= description %></h3>
            <a href="/"
               class="u-align-center u-btn u-btn-round u-button-style u-custom-font u-font-montserrat u-hidden-xs u-hover-feature u-radius u-btn-1">ÎNAPOI
                ACASĂ </a>
