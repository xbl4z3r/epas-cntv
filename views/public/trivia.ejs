    <script>
        const submitAnswer = (answerId) => {
            fetch(`/trivia/<%= session._id %>`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({answer: answerId})
            }).then(response => response.json()).then(data => {
                const answerButtons = document.querySelectorAll('.u-group-1');
                if (!data.success) answerButtons[answerId].style.backgroundColor = 'red';
                answerButtons[data.correctAnswerIndex].style.backgroundColor = 'green';
                setTimeout(() => {
                    window.location.reload();
                }, 2500);
            })
        }
    </script>
