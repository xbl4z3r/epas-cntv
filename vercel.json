{
	"version": 2,
	"builds": [
		{
			"src": "dist/index.js",
			"use": "@vercel/node",
			"config": { "includeFiles": ["dist/**"] }
		},
		{
			"src": "dist/schemas/**",
			"use": "@vercel/node",
			"config": { "includeFiles": ["dist/schemas/**"] }
		},
		{
			"src": "public/**",
			"use": "@now/static"
		},
		{
			"src": "views/**",
			"use": "@now/static"
		}
	],
	"routes": [
		{
			"src": "/(.*)",
			"dest": "dist/index.js"
		}
	]
}