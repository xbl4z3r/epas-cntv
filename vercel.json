{
	"version": 2,
	"builds": [
		{
			"src": "dist/index.js",
			"use": "@vercel/node",
			"config": { "includeFiles": ["dist/**"] }
		},
		{
			"src": "prod/public/**",
			"use": "@now/static"
		},
		{
			"src": "prod/views/**",
			"use": "@now/static"
		}
	],
	"routes": [
		{
			"src": "/(.*)",
			"dest": "dist/index.js"
		}
	]
}