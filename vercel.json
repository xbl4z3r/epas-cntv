{
	"version": 2,
	"builds": [
		{
			"src": "src/index.ts",
			"use": "@vercel/node",
			"config": { "includeFiles": ["src/**"] }
		},
		{
			"src": "src/schemas/**",
			"use": "@vercel/node",
			"config": { "includeFiles": ["src/schemas/**"] },
		},
		{
			"src": "public/**",
			"use": "@now/static"
		},
		{
			"src": "views/**",
			"use": "@now/static"
		}
	],
	"routes": [
		{
			"src": "/(.*)",
			"dest": "src/index.ts"
		}
	]
}